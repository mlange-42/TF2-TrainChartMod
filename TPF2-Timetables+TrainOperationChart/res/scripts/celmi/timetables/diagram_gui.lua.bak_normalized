    ra:setLayout(menu.renderLayout)
    local rw = WINDOW_WIDTH - STATION_PANEL_WIDTH - STATION_LABEL_WIDTH
    local rh = WINDOW_HEIGHT - TITLE_BAR_H - TIME_LABEL_HEIGHT
    ra:setMinimumSize(api.gui.util.Size.new(rw, rh))
