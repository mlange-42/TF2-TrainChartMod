                            tll:addItem(cont, rect)
                            table.insert(menu.timeLabelViews, cont)
                        end
                    else
                        debugPrint("timeLabels: raRect or tlcRect invalid")
                    end
                    -- 临时诊断：打印边框视图/时间标签容器实际渲染矩形。
                    -- lrv/tmCont 刚 addItem 进嵌套布局，同帧 getContentRect 为 0，需再等一帧（双 invokeLater）。
